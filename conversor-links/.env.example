# Copie este arquivo para .env.local e preencha

# Connection string do Neon (Dashboard do projeto > Connect). Sem isso o app funciona, só não salva histórico.
DATABASE_URL=

# Senha pra proteger o app quando ele estiver na internet (deixe vazio rodando local)
APP_SENHA=

# Token que a extensão do Chrome usa pra mandar produtos pra fila (invente um texto longo e aleatório)
EXTENSAO_TOKEN=
